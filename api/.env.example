NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_APP_URL=http://localhost:5173
# Lista opcional separada por comas para producción y staging.
WEB_APP_URLS=
SUPABASE_URL=https://gvmvmrusscsfbndnbvbr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7gL_lw2MMSwIFf_0nmHDzA_ILdkTI1T
# Solo en el servidor. No usar estas claves en VITE_ ni en las apps.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Conexión PostgreSQL del proyecto correcto; rol login sghu_api o membresía para SET ROLE.
# Para la nube usar TLS con verificación del certificado (?sslmode=verify-full).
DATABASE_URL=

# Opcional: certificado CA de Supabase (PEM) para verificar el servidor TLS. Si se define, se quita sslmode de la URL.
DB_SSL_CA=

# Seguridad (SEG-08). Proxies de confianza delante de la API: 0 en local, 1 en Render.
TRUST_PROXY_HOPS=0
# Solicitudes por IP y minuto en toda la API (300 si se deja vacío).
RATE_LIMIT_MAX=
