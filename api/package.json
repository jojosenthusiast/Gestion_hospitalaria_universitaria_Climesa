{
  "name": "sghu-climesa-backend",
  "version": "0.3.0",
  "private": true,
  "description": "API modular de SGHU-CLIMESA con Node.js y TypeScript",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:debug": "ts-node-dev --inspect --respawn --transpile-only src/main.ts",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "api:generate": "ts-node scripts/openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@supabase/supabase-js": "2.50.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "joi": "17.13.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.10",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.4",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "supabase": "2.122.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@fastify/static": {
      "content-disposition": "2.0.1"
    }
  }
}
