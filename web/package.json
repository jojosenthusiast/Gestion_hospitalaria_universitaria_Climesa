    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.3",
    "vite": "6.2.6",
