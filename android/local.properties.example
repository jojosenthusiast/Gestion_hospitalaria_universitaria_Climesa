# Copiar a android/local.properties (no se sube). Android Studio agrega sdk.dir solo.
# Las URL de la API y de Supabase NO van aqui: el build las lee como propiedades de Gradle
# (CLIMESA_API_BASE_URL, CLIMESA_SUPABASE_URL, CLIMESA_SUPABASE_PUBLISHABLE_KEY).
# Defínelas en ~/.gradle/gradle.properties; ver android/README.md. Nunca pongas service_role.
sdk.dir=<ruta del SDK de Android>
