// Copiar a ios/Config.xcconfig (no se sube) para cambiar la URL de la API en tu Mac.
// Config/Debug.xcconfig y Config/Release.xcconfig la incluyen al final si existe.
// En xcconfig "//" inicia comentario: escribe https:/$()/ en las URLs.
// La URL y la clave publicable de Supabase viven en CLIMESA/Resources/Configuration.plist (públicas; nunca service_role).
CLIMESA_API_BASE_URL = https:/$()/sghu-api.onrender.com/api/v1
